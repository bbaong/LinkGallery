generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum CoverType {
  SOLID
  GRADIENT
  GLASS
  IMAGE
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum FolderMemberRole {
  OWNER
  EDITOR
}

enum FolderMemberStatus {
  ACTIVE
  LEFT
  KICKED
}

enum FolderActivityType {
  LINK_ADDED
  MEMBER_JOINED
  MEMBER_LEFT
  MEMBER_KICKED
}

model User {
  id           String       @id @default(uuid())
  username     String       @unique
  email        String?      @unique
  passwordHash String?
  nickname     String
  avatarUrl    String?
  avatarType   CoverType?
  avatarValue  String?      @db.VarChar(2048)
  bannerType   CoverType    @default(GRADIENT)
  bannerValue  String       @default("#C6B3FF|#6427C8") @db.VarChar(2048)
  googleId     String?      @unique
  provider     AuthProvider @default(LOCAL)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  folders              Folder[]
  folderMemberships    FolderMember[]
  createdFolderInvites FolderInvite[]
  links                Link[]
  folderActivitiesAsActor  FolderActivity[] @relation("FolderActivityActor")
  folderActivitiesAsTarget FolderActivity[] @relation("FolderActivityTarget")
}

model Folder {
  id         String    @id @default(uuid())
  userId     String
  name       String
  icon       String?
  coverType  CoverType @default(GRADIENT)
  coverValue String
  position   Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  links      Link[]
  members    FolderMember[]
  invites    FolderInvite[]
  activities FolderActivity[]

  @@index([userId])
}

model FolderInvite {
  id              String    @id @default(uuid())
  folderId        String
  createdByUserId String
  code            String    @unique @db.VarChar(6)
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?

  folder           Folder         @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdBy        User           @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  joinedMemberships FolderMember[]

  @@index([folderId])
}

model FolderMember {
  id                 String             @id @default(uuid())
  folderId           String
  userId             String
  role               FolderMemberRole
  status             FolderMemberStatus @default(ACTIVE)
  joinedAt           DateTime           @default(now())
  leftAt             DateTime?
  lastJoinedInviteId String?

  folder           Folder        @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastJoinedInvite FolderInvite? @relation(fields: [lastJoinedInviteId], references: [id], onDelete: SetNull)

  @@unique([folderId, userId])
  @@index([userId])
  @@index([folderId, status])
}

model Link {
  id          String   @id @default(uuid())
  userId      String
  folderId    String
  title       String
  url         String   @db.VarChar(2048)
  urlHash     String   @db.Char(64)
  description String?  @db.Text
  faviconUrl      String?   @db.VarChar(512)
  previewImageUrl String?   @db.VarChar(1024)
  position    Int       @default(0)
  lastVisitedAt DateTime?
  category      String?   @db.VarChar(30)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([folderId, urlHash])
  @@index([userId])
  @@index([folderId])
  @@index([folderId, category])
  @@index([userId, lastVisitedAt])
}

model FolderActivity {
  id             String             @id @default(uuid())
  folderId       String
  actorUserId    String?
  type           FolderActivityType
  targetName     String?            @db.VarChar(255)
  targetUserId   String?
  actorNickname  String             @db.VarChar(40)
  targetNickname String?            @db.VarChar(40)
  createdAt      DateTime           @default(now())

  folder     Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  actor      User?  @relation("FolderActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser User?  @relation("FolderActivityTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([folderId, createdAt])
}
